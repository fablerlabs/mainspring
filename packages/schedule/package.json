{
  "name": "@mainspring/schedule",
  "version": "0.1.0",
  "description": "Mainspring schedule: pure, model-agnostic logic for deciding whether a session should run now and with what focus — interval/cron cadence, exponential backoff on failures, and a fail-safe STOP kill switch. No OS timers, no processes; any host can drive it.",
  "license": "Apache-2.0",
  "homepage": "https://github.com/fablerlabs/mainspring/tree/main/packages/schedule#readme",
  "bugs": {
    "url": "https://github.com/fablerlabs/mainspring/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fablerlabs/mainspring.git",
    "directory": "packages/schedule"
  },
  "keywords": [
    "autonomous-agent",
    "scheduling",
    "cron",
    "backoff",
    "mainspring"
  ],
  "author": "Fabler Labs",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/test/*.test.js"
  },
  "dependencies": {},
  "devDependencies": {
    "typescript": "^5.6.3",
    "@types/node": "^22.10.2"
  }
}
