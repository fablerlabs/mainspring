{
  "name": "@mainspring/example-full-stack-test",
  "version": "0.1.0",
  "private": true,
  "description": "Full-stack integration proof: core + brains + governance + ledger + memory + scrub + relay wired into one realistic multi-step session, offline and with zero credentials.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "tsc -p tsconfig.json && node dist/main.js",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/test/*.test.js"
  },
  "dependencies": {
    "@mainspring/core": "workspace:*",
    "@mainspring/brains": "workspace:*",
    "@mainspring/governance": "workspace:*",
    "@mainspring/ledger": "workspace:*",
    "@mainspring/memory": "workspace:*",
    "@mainspring/scrub": "workspace:*",
    "@mainspring/relay": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "@types/node": "^22.10.2"
  }
}
