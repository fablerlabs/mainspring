{
  "name": "@mainspring/example-content-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Second worked example: a content-business agent — draft, honesty-disclosure governance, a tiny budget, and a MockRelay human-in-the-loop handoff before the disclosed publish.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "tsc -p tsconfig.json && node dist/main.js",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/test/*.test.js"
  },
  "dependencies": {
    "@mainspring/core": "workspace:*",
    "@mainspring/brains": "workspace:*",
    "@mainspring/governance": "workspace:*",
    "@mainspring/ledger": "workspace:*",
    "@mainspring/memory": "workspace:*",
    "@mainspring/relay": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "@types/node": "^22.10.2"
  }
}
